# AUTOENCODER-HIDS | Dashboard (SQLite — slim build) — python:3.12-slim

FROM python:3.12-slim

LABEL maintainer="NeumaOps / UTAMU HIDS Project"

WORKDIR /app

RUN printf 'Acquire::http::Timeout "30";\nAcquire::Retries "3";\n' \
    > /etc/apt/apt.conf.d/99timeout \
 && apt-get update -qq \
 && apt-get install -y -q --no-install-recommends \
        libx11-6 libxext6 libxrender1 libxrandr2 libxfixes3 \
        libxcursor1 libxi6 libxtst6 libxcomposite1 libxdamage1 \
        libxcb1 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 \
        libxcb-randr0 libxcb-render-util0 libxcb-shape0 libxcb-sync1 \
        libxcb-xfixes0 libxcb-xinerama0 libxcb-xkb1 libxcb-util1 \
        libxcb-cursor0 \
        libxkbcommon0 libxkbcommon-x11-0 \
        libgl1 libglx-mesa0 libegl1 \
        libglib2.0-0 libdbus-1-3 \
        # QtWebEngine / Chromium runtime dependencies
        libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libcups2 \
        libdrm2 libdbus-1-3 libexpat1 libfontconfig1 libgbm1 \
        libnspr4 libpango-1.0-0 libpangocairo-1.0-0 libx11-xcb1 \
        libxcomposite1 libxcursor1 libxdamage1 libxext6 libxfixes3 \
        libxi6 libxrandr2 libxrender1 libxtst6 xserver-xorg-core \
        fonts-jetbrains-mono fontconfig \
        ca-certificates \
        libsqlite3-0 \
        libgssapi-krb5-2 \
        libpcap0.8 \
        libpcap-dev \
 && fc-cache -fv \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /root/.config/pip \
 && printf '[global]\ntimeout = 120\nretries = 5\n' > /root/.config/pip/pip.conf

COPY docker/requirements.dashboard.txt .
RUN pip install --upgrade pip \
 && pip install --no-cache-dir --timeout 120 --retries 5 -r requirements.dashboard.txt

# Force re-copy of app source on every build (busts Docker layer cache)
ARG CACHEBUST=1
COPY api/   ./api/
COPY src/   ./src/
COPY app/   ./app/
COPY docs/  ./docs/

RUN groupadd -r hids && useradd -r -g hids -d /app -s /sbin/nologin hids \
 && mkdir -p /app/db /app/models /app/docs \
 && chown -R hids:hids /app

# Running as root for scapy raw socket access (cap_add: NET_RAW)

VOLUME ["/app/db", "/app/models", "/app/docs"]

ENV DATABASE_URL="sqlite:////app/db/hids_forensics.db" \
    HIDS_MODEL_PATH="/app/models/baseline_ae.keras" \
    HIDS_API_URL="http://backend:9000" \
    GUI_THEME="dark" \
    QT_QPA_PLATFORM="xcb" \
    QT_LOGGING_RULES="*.debug=false" \
    QT_AUTO_SCREEN_SCALE_FACTOR="1" \
    PYTHONUNBUFFERED="1" \
    PYTHONDONTWRITEBYTECODE="1" \
    PYTHONPATH="/app/host_packages:/app"

CMD ["python", "app/dashboard.py"]