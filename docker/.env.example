# ─────────────────────────────────────────────────────────────────────────────
# AUTOENCODER-HIDS  |  Environment  (SQLite — slim build)
# cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED: your venv site-packages ─────────────────────────────────────────
# Find your path:
#   python3 -c "import site; print(site.getsitepackages()[0])"
# Your value (from earlier):
HOST_SITE_PACKAGES=/home/l391lninj1/Desktop/AUTOENCODER_HIDS/env/lib/python3.12/site-packages

# ── Database (SQLite — zero config) ───────────────────────────────────────────
DATABASE_URL=sqlite:////app/db/hids_forensics.db

# ── Model paths (inside container, mapped from hids_models volume) ────────────
HIDS_MODEL_PATH=/app/models/baseline_ae.keras
HIDS_SCALER_PATH=/app/models/scaler.pkl
HIDS_THRESHOLD_CONFIG=/app/configs/threshold.yaml

# ── Dashboard ─────────────────────────────────────────────────────────────────
GUI_THEME=dark
DISPLAY=:0

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
